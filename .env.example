# Copy to .env.local and fill in when you wire up integrations.

# Your production site URL — no trailing slash. Used for canonical links,
# sitemap.xml, robots.txt, Open Graph/Twitter metadata, and JSON-LD.
# Falls back to a placeholder in src/lib/seo.ts if unset, so set this before
# deploying to production.
NEXT_PUBLIC_SITE_URL=https://www.danielood.com

# Resend — used by the newsletter signup form (src/app/api/newsletter/route.ts).
# RESEND_API_KEY=
# RESEND_AUDIENCE_ID=
